<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.SVGPath?>


<VBox xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="ad.ovo.wol.controller.MainController"
      styleClass="root"
      prefWidth="720" prefHeight="540">


    <HBox styleClass="app-header">
        <children>

            <StackPane styleClass="header-icon-bg">
                <SVGPath styleClass="header-icon" scaleX="0.75" scaleY="0.75"
                         content="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/>
            </StackPane>

            <VBox HBox.hgrow="ALWAYS" alignment="CENTER_LEFT" spacing="2">
                <Label styleClass="app-title" text="局域网 WOL 唤醒工具"/>
                <Label styleClass="app-subtitle" text="通过 UDP 广播发送魔术包，唤醒局域网内远程计算机"/>
            </VBox>

            <Button fx:id="themeButton" styleClass="theme-button" onAction="#onToggleTheme"/>
        </children>
    </HBox>


    <HBox spacing="12" VBox.vgrow="ALWAYS">
        <children>

            <VBox styleClass="card" prefWidth="250" minWidth="220" maxWidth="320">
                <Label styleClass="card-title" text="设备列表"/>
                <ListView fx:id="deviceList" VBox.vgrow="ALWAYS"
                          styleClass="device-list"/>
                <HBox spacing="8" style="-fx-padding: 10 0 0 0;">
                    <Button fx:id="newDeviceButton" styleClass="secondary-button" text="＋ 新建"
                            onAction="#onNewDevice" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                    <Button fx:id="deleteDeviceButton" styleClass="secondary-button" text="删除"
                            onAction="#onDeleteDevice" prefWidth="76"/>
                </HBox>
            </VBox>


            <VBox styleClass="card" HBox.hgrow="ALWAYS">
                <HBox alignment="CENTER_LEFT" spacing="8">
                    <Label styleClass="card-title" text="设备信息" HBox.hgrow="ALWAYS"/>
                    <CheckBox fx:id="srvModeBox" styleClass="srv-mode-box" text="SRV 模式"
                              selected="false"/>
                </HBox>
                <GridPane hgap="8" vgap="12">
                    <columnConstraints>
                        <ColumnConstraints minWidth="76" prefWidth="76" maxWidth="76"/>
                        <ColumnConstraints hgrow="ALWAYS" minWidth="220"/>
                    </columnConstraints>
                    <rowConstraints>
                        <RowConstraints vgrow="SOMETIMES"/>
                        <RowConstraints vgrow="SOMETIMES"/>
                        <RowConstraints vgrow="SOMETIMES"/>
                        <RowConstraints vgrow="SOMETIMES"/>
                    </rowConstraints>

                    <Label styleClass="field-label" text="设备名" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                    <TextField fx:id="nameField" GridPane.columnIndex="1" GridPane.rowIndex="0"
                               promptText="例如 书房电脑（可选）"/>

                    <Label styleClass="field-label" text="MAC 地址" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                    <TextField fx:id="macField" GridPane.columnIndex="1" GridPane.rowIndex="1"
                               promptText="例如 00:1A:2B:3C:4D:5E"
                               onAction="#onSend"/>

                    <Label fx:id="broadcastLabel" styleClass="field-label" text="广播地址" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
                    <TextField fx:id="broadcastField" GridPane.columnIndex="1" GridPane.rowIndex="2"
                               promptText="IP 或主机名"/>

                    <Label fx:id="portLabel" styleClass="field-label" text="目标端口" GridPane.columnIndex="0" GridPane.rowIndex="3"/>
                    <TextField fx:id="portField" GridPane.columnIndex="1" GridPane.rowIndex="3"
                               maxWidth="220"
                               text="9" promptText="默认 9"/>
                </GridPane>
            </VBox>
        </children>
    </HBox>


    <HBox spacing="10">
        <Button fx:id="sendButton" styleClass="primary-button" text="发送唤醒包"
                onAction="#onSend" maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
        <Button fx:id="saveButton" styleClass="secondary-button" text="保存配置"
                onAction="#onSave" prefWidth="120"/>
    </HBox>


    <VBox styleClass="card">
        <Label styleClass="card-title" text="全局设置与状态"/>
        <HBox spacing="8" alignment="CENTER_LEFT" style="-fx-padding: 0 0 12 0;">
            <Label styleClass="field-label" text="连发次数"/>
            <TextField fx:id="countField" maxWidth="110"
                       text="5" promptText="默认 5"/>
            <Label styleClass="field-label" text="（每次点击连发 N 个包，防丢包）" alignment="CENTER_LEFT"/>
        </HBox>
        <Label fx:id="statusBanner" styleClass="status-banner" wrapText="true"
               text="就绪 — 选择或新建设备，输入 MAC 后发送"/>
    </VBox>

    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>
</VBox>
